{
  "version": 8,
  "name": "Organic Moto Dark Ride",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "{tiles_path}",
      "maxzoom": 14,
      "attribution": "© OpenMapTiles.org © OpenStreetMap contributors"
    }
  },
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#000000" }
    },
    {
      "id": "ride-roads",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track", "path"]]
      ],
      "paint": {
        "line-color": "#777777",
        "line-opacity": 0.72,
        "line-width": { "base": 1.2, "stops": [[8, 0.45], [12, 1.2], [14, 2.7]] },
        "line-cap": "round",
        "line-join": "round"
      },
      "minzoom": 8
    },
    {
      "id": "ride-road-labels",
      "type": "symbol",
      "source": "omt",
      "source-layer": "transportation_name",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"]]
      ],
      "minzoom": 10,
      "layout": {
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-max-angle": 35,
        "text-optional": true
      },
      "paint": {
        "text-color": "#B0B0B0",
        "text-halo-color": "#000000",
        "text-halo-width": 1.2,
        "text-opacity": 0.82
      }
    }
  ]
}
